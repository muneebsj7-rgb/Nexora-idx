# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Server & Admin Configuration
PORT=3000
NODE_ENV=development
ADMIN_EMAILS=muneebsj7@gmail.com
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# TRON USDT (TRC20) Server-Side Verifier Configuration (TronGrid)
# Allowed TRON_NETWORK values: nile | shasta | mainnet (defaults to nile in development/testnet mode)
TRON_NETWORK=nile
TRONGRID_API_KEY=
TRON_REQUIRED_CONFIRMATIONS=19
TRON_REQUIRE_SOLIDIFIED=true
TRONGRID_TIMEOUT_MS=8000
TRONGRID_MAX_RETRIES=1
TRON_TREASURY_ADDRESS=
ALLOW_TRON_MAINNET_VERIFICATION=false